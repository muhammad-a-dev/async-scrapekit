# Copy to .env and adjust. Never commit real secrets.
SCRAPEKIT_USER_AGENT=async-scrapekit/0.1 (+https://github.com/muhammad-a-dev/async-scrapekit)
SCRAPEKIT_MAX_CONCURRENCY_PER_HOST=2
SCRAPEKIT_REQUESTS_PER_SECOND=1.0
SCRAPEKIT_MAX_RETRIES=3
SCRAPEKIT_BACKOFF_BASE=0.5
SCRAPEKIT_BACKOFF_CAP=30.0
SCRAPEKIT_TIMEOUT=30.0
SCRAPEKIT_RESPECT_ROBOTS=true
SCRAPEKIT_ALLOW_DISALLOWED=false
SCRAPEKIT_LOG_LEVEL=INFO
